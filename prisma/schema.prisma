generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====
enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
  CASHIER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  OVERDUE
  PAID
  VOID
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  RETURN
  SALE
  PURCHASE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CHECK
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum DeliveryNoteStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  APPROVED
  CANCELLED
}

// ===== AUTH =====
model User {
  id           String   @id @default(cuid())
  email        String
  password     String
  name         String?
  image        String?
  role         Role     @default(VIEWER)
  // Till PIN, argon2id. Only the till checks it; never a web login credential
  // (the web login verifies `password`).
  pinHash      String?
  isSuperAdmin Boolean  @default(false)
  orgId        String?
  org          Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([email, orgId])
  @@index([orgId])
  @@index([isSuperAdmin])
}

model Org {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  logo            String?
  status          OrgStatus          @default(ACTIVE)
  currency        String             @default("RWF")
  timezone        String             @default("Africa/Kigali")
  deletedAt       DateTime?
  users           User[]
  products        Product[]
  locations       Location[]
  customers       Customer[]
  vendors         Vendor[]
  invoices        Invoice[]
  expenses        Expense[]
  invoiceSequence InvoiceSequence?
  docSequences    DocSequence[]
  salesOrders     SalesOrder[]
  deliveryNotes   DeliveryNote[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceiptNote[]
  auditLogs       AuditLog[]
  batches         Batch[]
  stockWriteOffs  StockWriteOff[]
  promotions      Promotion[]
  priceChanges    PriceChange[]
  lanes           Lane[]
  laneTokens      LaneToken[]
  shifts          Shift[]
  sales           Sale[]
  saleLines       SaleLine[]
  tenders         Tender[]
  createdAt       DateTime           @default(now())
}

// Platform-wide settings (singleton row, id = "platform")
model PlatformSettings {
  id              String   @id @default("platform")
  platformName    String   @default("Simplex")
  supportEmail    String?
  defaultCurrency String   @default("RWF")
  defaultTimezone String   @default("Africa/Kigali")
  allowSignups    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ===== STOCK =====
model Product {
  id                 String              @id @default(cuid())
  sku                String
  name               String
  description        String?
  image              String?
  category           String              @default("General")
  unitPrice          Decimal             @db.Decimal(12, 2)
  costPrice          Decimal?            @db.Decimal(12, 2)
  reorderLevel       Decimal             @db.Decimal(12, 3) @default(10)
  barcode            String?
  plu                String?
  isWeighed          Boolean             @default(false)
  taxTyCd            TaxType             @default(B)
  department         String              @default("General")
  packSize           String?
  shelfLifeDays      Int?
  orgId              String
  org                Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stockLevels        StockLevel[]
  movements          StockMovement[]
  batches            Batch[]
  promotions         Promotion[]
  priceChanges       PriceChange[]
  saleLines          SaleLine[]
  writeOffs          StockWriteOff[]
  lineItems          InvoiceLineItem[]
  salesOrderLines    SalesOrderLine[]
  deliveryNoteLines  DeliveryNoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@unique([sku, orgId])
  @@unique([barcode, orgId])
  @@index([plu, orgId])
  @@index([orgId])
}

// RRA EBM 2.1 tax codes: A = A-EX (exempt), B = B-18.00%, C, D.
enum TaxType {
  A
  B
  C
  D
}

model Location {
  id            String             @id @default(cuid())
  name          String
  code          String?
  address       String?
  parentId      String?
  parent        Location?          @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Location[]         @relation("LocationHierarchy")
  orgId         String
  org           Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stockLevels   StockLevel[]
  movementsFrom StockMovement[]    @relation("from")
  movementsTo   StockMovement[]    @relation("to")
  writeOffs     StockWriteOff[]
  lanes         Lane[]
  deliveryNotes DeliveryNote[]
  goodsReceipts GoodsReceiptNote[]
  createdAt     DateTime           @default(now())

  @@index([orgId])
  @@index([orgId, parentId])
}

model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qty        Decimal  @db.Decimal(12, 3) @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
}

// Sale uniqueness lives in SQL, not here: a partial unique index
// "StockMovement_sale_ref_product_key" on (referenceId, productId) WHERE type = 'SALE'.
// Prisma cannot express a partial index. It must stay partial: GRN and delivery-note
// approval reuse referenceId, and one GRN may hold two movements of a product in
// different batches.
model StockMovement {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  fromLocationId String?
  fromLocation   Location?    @relation("from", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("to", fields: [toLocationId], references: [id])
  qty            Decimal @db.Decimal(12, 3)
  type           MovementType
  reason         String?
  referenceId    String?
  // Batch is a label on stock, not its owner: deleting a batch keeps the movement.
  batchId        String?
  batch          Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  ebmSyncState   EbmSyncState @default(PENDING)
  orgId          String
  createdAt      DateTime     @default(now())

  @@index([orgId, productId])
  @@index([orgId, createdAt])
  @@index([batchId])
}

enum EbmSyncState {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

enum WriteOffReason {
  EXPIRY
  DAMAGE
  THEFT
  MARKDOWN
}

model Batch {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  lot        String
  receivedAt DateTime        @default(now())
  bestBefore DateTime?
  orgId      String
  org         Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  writeOffs  StockWriteOff[]

  @@index([orgId, productId])
  @@index([orgId, bestBefore])
}

model StockWriteOff {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  locationId String
  location   Location       @relation(fields: [locationId], references: [id])
  batchId    String?
  batch      Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  qty        Decimal        @db.Decimal(12, 3)
  reason     WriteOffReason
  note       String?
  orgId      String
  org         Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, productId])
}

// ===== CUSTOMERS =====
model Customer {
  id            String       @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  creditLimit   Decimal      @db.Decimal(12, 2) @default(0)
  creditBalance Decimal      @db.Decimal(12, 2) @default(0)
  status        EntityStatus @default(ACTIVE)
  orgId         String
  org           Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@unique([email, orgId])
  @@index([orgId])
  @@index([orgId, status])
}

// ===== VENDORS =====
model Vendor {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  paymentTerms   String          @default("NET30")
  status         EntityStatus    @default(ACTIVE)
  orgId          String
  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@unique([email, orgId])
  @@index([orgId])
  @@index([orgId, status])
}

// ===== FINANCE =====
model Invoice {
  id            String            @id @default(cuid())
  invoiceNo     String
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        InvoiceStatus     @default(DRAFT)
  subtotal      Decimal           @db.Decimal(12, 2) @default(0)
  tax           Decimal           @db.Decimal(12, 2) @default(0)
  total         Decimal           @db.Decimal(12, 2) @default(0)
  amountPaid    Decimal           @db.Decimal(12, 2) @default(0)
  dueDate       DateTime
  notes         String?
  orgId         String
  org           Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]
  payments      Payment[]
  deliveryNote  DeliveryNote?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sentAt        DateTime?
  deletedAt     DateTime?

  @@unique([invoiceNo, orgId])
  @@index([orgId, customerId])
  @@index([orgId, status])
  @@index([orgId, dueDate])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String?
  qty         Decimal  @db.Decimal(12, 3) @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  date      DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([invoiceId])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  receipt     String?
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, date])
}

model InvoiceSequence {
  orgId   String @id
  lastSeq Int    @default(0)
  org     Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Generic per-org per-doc-kind sequence (SO, DN, PO, GRN)
model DocSequence {
  orgId   String
  kind    String
  lastSeq Int    @default(0)
  org     Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, kind])
}

// ===== SALES =====
model SalesOrder {
  id            String           @id @default(cuid())
  orderNo       String
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        SalesOrderStatus @default(DRAFT)
  orderDate     DateTime         @default(now())
  expectedDate  DateTime?
  notes         String?
  subtotal      Decimal          @db.Decimal(12, 2) @default(0)
  total         Decimal          @db.Decimal(12, 2) @default(0)
  orgId         String
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines         SalesOrderLine[]
  deliveryNotes DeliveryNote[]
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@unique([orderNo, orgId])
  @@index([orgId, status])
  @@index([orgId, customerId])
}

model SalesOrderLine {
  id           String             @id @default(cuid())
  orderId      String
  order        SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty          Decimal @db.Decimal(12, 3)
  qtyDelivered Decimal            @db.Decimal(12, 3) @default(0)
  unitPrice    Decimal            @db.Decimal(12, 2)
  amount       Decimal            @db.Decimal(12, 2)
  dnLines      DeliveryNoteLine[]

  @@index([orderId])
}

model DeliveryNote {
  id           String             @id @default(cuid())
  noteNo       String
  orderId      String
  order        SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status       DeliveryNoteStatus @default(DRAFT)
  approvedAt   DateTime?
  approvedById String?
  notes        String?
  invoiceId    String?            @unique
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orgId        String
  org          Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines        DeliveryNoteLine[]
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([noteNo, orgId])
  @@index([orgId, status])
  @@index([orderId])
}

model DeliveryNoteLine {
  id          String          @id @default(cuid())
  noteId      String
  note        DeliveryNote    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderLineId String?
  orderLine   SalesOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  qty         Decimal @db.Decimal(12, 3)

  @@index([noteId])
}

// ===== PROCUREMENT =====
model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNo      String
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  subtotal     Decimal             @db.Decimal(12, 2) @default(0)
  total        Decimal             @db.Decimal(12, 2) @default(0)
  orgId        String
  org          Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceiptNote[]
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@unique([orderNo, orgId])
  @@index([orgId, status])
  @@index([orgId, vendorId])
}

model PurchaseOrderLine {
  id          String             @id @default(cuid())
  orderId     String
  order       PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty         Decimal @db.Decimal(12, 3)
  qtyReceived Decimal            @db.Decimal(12, 3) @default(0)
  unitPrice   Decimal            @db.Decimal(12, 2)
  amount      Decimal            @db.Decimal(12, 2)
  grnLines    GoodsReceiptLine[]

  @@index([orderId])
}

model GoodsReceiptNote {
  id           String             @id @default(cuid())
  noteNo       String
  orderId      String
  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status       GoodsReceiptStatus @default(DRAFT)
  approvedAt   DateTime?
  approvedById String?
  notes        String?
  orgId        String
  org          Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines        GoodsReceiptLine[]
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([noteNo, orgId])
  @@index([orgId, status])
  @@index([orderId])
}

model GoodsReceiptLine {
  id          String             @id @default(cuid())
  noteId      String
  note        GoodsReceiptNote   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderLineId String?
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  qty         Decimal @db.Decimal(12, 3)

  @@index([noteId])
}

// ===== AUDIT =====
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

// Till-level discounts (Task 12 SaleLine/Sale carry discountKind + discountValue).
// v1 scope is price overrides and percent/amount discounts only; no multi-buy,
// mix-and-match or loyalty-conditional pricing.
enum DiscountKind {
  PERCENT
  AMOUNT
}

// A time-boxed price override. The database enforces endsAt > startsAt and, per
// product, non-overlapping [startsAt, endsAt) ranges (see the migration).
model Promotion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  price     Decimal  @db.Decimal(12, 2)
  startsAt  DateTime
  endsAt    DateTime
  orgId     String
  org        Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orgId, startsAt])
}

model PriceChange {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedAt   DateTime @default(now())
  changedById String
  orgId       String
  org          Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, productId, changedAt])
}

enum TenderMethod {
  CASH
  CREDIT
  CASH_CREDIT
  BANK_CHECK
  CARD
  MOBILE_MONEY
  OTHER
}

model Lane {
  id         String    @id @default(cuid())
  code       String
  name       String
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  orgId      String
  org         Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mrc        String?
  // The RRA branch id. RRA issues it per BRANCH, so every lane of a shop
  // legitimately shares it: deliberately NOT unique. Nullable (an unconfigured
  // lane).
  bhfId      String?
  // The till's device serial (the `dvcSrlNo` it sends to selectInitInfo). This
  // is the real per-till identity: the VSDC keeps invoice counters per DEVICE
  // (vsdc.txt 3.3.1.1, InitDevice). Nullable (a lane may be unconfigured);
  // Postgres treats NULLs as distinct in a unique index, so several
  // unconfigured lanes are legal, but two lanes in one org cannot claim one
  // serial.
  dvcSrlNo   String?
  // Mirror of the VSDC's per-device invoice counter (the last sale invoice
  // number selectInitInfo reported / the till last confirmed). The till's
  // authoritative copies live in its local database (till-store `invc_seq`,
  // one per receipt type); this is where the cloud records the VSDC's value.
  lastInvcNo Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  shifts     Shift[]
  sales      Sale[]
  tokens     LaneToken[]

  @@unique([code, orgId])
  @@unique([dvcSrlNo, orgId])
}

// A till's device credential. Only the SHA-256 hex digest of a 256-bit random
// token is stored; there is deliberately no column that can hold the token itself.
model LaneToken {
  id         String    @id @default(cuid())
  laneId     String
  lane       Lane      @relation(fields: [laneId], references: [id], onDelete: Cascade)
  tokenHash  String
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([laneId])
}

model Shift {
  id           String    @id @default(cuid())
  laneId       String
  lane         Lane      @relation(fields: [laneId], references: [id])
  openedById   String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @db.Decimal(12, 2)
  declaredCash Decimal?  @db.Decimal(12, 2)
  orgId        String
  org           Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([orgId, laneId])
}

model Sale {
  id            String        @id @default(cuid())
  shiftId       String
  shift         Shift         @relation(fields: [shiftId], references: [id])
  laneId        String
  lane          Lane          @relation(fields: [laneId], references: [id])
  invcNo        Int
  rcptNo        Int?
  totAmt        Decimal       @db.Decimal(12, 2)
  totTaxblAmt   Decimal       @db.Decimal(12, 2)
  totTaxAmt     Decimal       @db.Decimal(12, 2)
  buyerTin      String?
  discountKind  DiscountKind?
  discountValue Decimal?      @db.Decimal(12, 2)
  voidedAt      DateTime?
  orgId         String
  org            Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  soldAt        DateTime      @default(now())
  lines         SaleLine[]
  tenders       Tender[]

  @@unique([laneId, invcNo])
  @@index([orgId, soldAt])
  @@index([shiftId])
}

model SaleLine {
  id            String        @id @default(cuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  itemSeq       Int
  qty           Decimal       @db.Decimal(12, 3)
  prc           Decimal       @db.Decimal(12, 2)
  taxTyCd       TaxType
  discountKind  DiscountKind?
  discountValue Decimal?      @db.Decimal(12, 2)
  orgId         String
  org            Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([saleId, itemSeq])
}

model Tender {
  id          String       @id @default(cuid())
  saleId      String
  sale        Sale         @relation(fields: [saleId], references: [id])
  pmtTyCd     TenderMethod
  amount      Decimal      @db.Decimal(12, 2)
  providerRef String?
  confirmed   Boolean      @default(false)
  orgId       String
  org          Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([saleId])
}
